@* Stroke icons drawn in currentColor. Decorative: the text beside each one says what it is. *@
<svg class="@Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Kind)
    {
        case "topic":
            <circle cx="12" cy="12" r="2.5" /><path d="M7.5 7.5a6.4 6.4 0 0 0 0 9M16.5 7.5a6.4 6.4 0 0 1 0 9M4.6 4.6a10.5 10.5 0 0 0 0 14.8M19.4 4.6a10.5 10.5 0 0 1 0 14.8" />
            break;
        case "queue":
            <rect x="3" y="5" width="18" height="4" rx="1" /><rect x="3" y="11" width="18" height="4" rx="1" /><rect x="3" y="17" width="12" height="3" rx="1" />
            break;
        case "sub":
            <path d="M6 4v9a3 3 0 0 0 3 3h10M15 12l4 4-4 4" />
            break;
        case "overview":
            <rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" />
            break;
        case "send":
            <path d="M4 12 20 4l-6 16-3-7z" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            break;
        case "arrow":
            <path d="M4 12h15M14 7l5 5-5 5" />
            break;
        case "chevron-down":
            <path d="m6 9 6 6 6-6" />
            break;
        case "chevron-right":
            <path d="m9 6 6 6-6 6" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "copy":
            <rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" />
            break;
        case "alert":
            <path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4M12 17v.5" />
            break;
        case "theme":
            <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" />
            break;
        case "logo":
            <path d="M4 7h10M4 12h16M4 17h7" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter] public int Size { get; set; } = 15;
    [Parameter] public string? Class { get; set; }
}

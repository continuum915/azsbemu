@inject IJSRuntime JS

@* A modal dialog: the page behind is dimmed and inert to clicks. Escape and the close button call OnClose unless
   CanClose is false (an operation is running and must be cancelled first). A click outside does nothing, so a stray
   click never throws away a half-written message. *@
<div class="modal-backdrop">
    <div class="card modal @Class" role="dialog" aria-modal="true" aria-labelledby="@titleId" tabindex="-1"
         @ref="panel" @onkeydown="OnKeyDownAsync">
        <div class="modal-head">
            <h2 id="@titleId">@Title</h2>
            <button class="banner-close" aria-label="Close" disabled="@(!CanClose)" @onclick="CloseAsync"><Icon Kind="close" Size="15" /></button>
        </div>
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool CanClose { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private readonly string titleId = "modal-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference panel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("sbBrowser.focusFirst", panel);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (CanClose) await OnClose.InvokeAsync();
    }
}

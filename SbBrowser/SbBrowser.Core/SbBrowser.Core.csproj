<Project Sdk="Microsoft.NET.Sdk">

  <!-- All of SbBrowser's Service Bus logic. No ASP.NET Core or UI dependencies, so any UI can host it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SbBrowser.Tests" />
  </ItemGroup>

</Project>
